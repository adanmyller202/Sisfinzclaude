rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSafeString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isSafeNumber(val, minVal, maxVal) {
      return val is number && val >= minVal && val <= maxVal;
    }

    // Helper to verify bilateral connection exists and is active between two distinct users
    function hasActiveConnection(userA, userB) {
      let connectionId = (userA < userB) ? ('conn_' + userA + '_' + userB) : ('conn_' + userB + '_' + userA);
      let connection = get(/databases/$(database)/documents/shared_connections/$(connectionId));
      return connection != null && connection.data.status == 'active';
    }

    // Helper to get partner UID from a 2-member array [uid1, uid2]
    function getPartnerUid(members) {
      return (members[0] == request.auth.uid) ? members[1] : members[0];
    }

    // Helper ensuring partner's root share object (amount, percentage, status) is strictly untouched
    // MANDATORY: Both existing and incoming documents MUST retain the 'shares' map and partner's share entry!
    function partnerShareUnchanged() {
      let partnerUid = getPartnerUid(resource.data.members);
      return request.resource.data.keys().hasAll(['shares']) &&
        resource.data.keys().hasAll(['shares']) &&
        request.resource.data.shares.get(partnerUid, null) == resource.data.shares.get(partnerUid, null);
    }

    // Helper ensuring partner's percentage is strictly untouched
    // MANDATORY: Both existing and incoming documents MUST retain the 'percentages' map and partner's percentage entry!
    function partnerPercentageUnchanged() {
      let partnerUid = getPartnerUid(resource.data.members);
      return request.resource.data.keys().hasAll(['percentages']) &&
        resource.data.keys().hasAll(['percentages']) &&
        request.resource.data.percentages.get(partnerUid, null) == resource.data.percentages.get(partnerUid, null);
    }

    // Helper ensuring partner's payment status in shares[partnerUid].status is unchanged
    function partnerShareStatusUnchanged() {
      let partnerUid = getPartnerUid(resource.data.members);
      return request.resource.data.shares.get(partnerUid, {}).get('status', null) == resource.data.shares.get(partnerUid, {}).get('status', null);
    }

    // Helper validating mathematical consistency during bill recalculation
    function isValidBillRecalculation() {
      let m0 = resource.data.members[0];
      let m1 = resource.data.members[1];
      let p0 = request.resource.data.percentages.get(m0, 0);
      let p1 = request.resource.data.percentages.get(m1, 0);
      let s0 = request.resource.data.shares.get(m0, {}).get('amount', 0);
      let s1 = request.resource.data.shares.get(m1, {}).get('amount', 0);

      return (p0 + p1 == 100) &&
        (s0 + s1 == request.resource.data.amount) &&
        partnerShareStatusUnchanged();
    }

    // Helper ensuring hiddenForUsers can only add or remove the caller's own UID
    function isValidHiddenForUsersUpdate() {
      let incomingHidden = request.resource.data.get('hiddenForUsers', []).toSet();
      let existingHidden = resource.data.get('hiddenForUsers', []).toSet();
      let added = incomingHidden.difference(existingHidden);
      let removed = existingHidden.difference(incomingHidden);

      return added.hasOnly([request.auth.uid]) && removed.hasOnly([request.auth.uid]);
    }

    // 2. User profile and private subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Private subcollections default: strictly private to owner
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }

      // Partner can ONLY create a shared transfer income record for an active partner
      match /incomes/{incomeId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isOwner(userId) || (
          isSignedIn() &&
          isValidId(incomeId) &&
          request.resource.data.userId == userId &&
          request.resource.data.category == 'Contas Compartilhadas' &&
          isSafeNumber(request.resource.data.amount, 0.01, 1000000000) &&
          hasActiveConnection(request.auth.uid, userId)
        );
      }
    }

    // 3. User directory (Private to owner, client-side listing prohibited)
    match /user_directory/{userId} {
      allow get: if isSignedIn(); // Allow finding users by UID if you have it
      allow list: if false; // BLOCK MASS ENUMERATION!
      allow create, update: if isOwner(userId) &&
        isValidId(userId) &&
        request.resource.data.uid == userId &&
        isSafeString(request.resource.data.email, 3, 150) &&
        isSafeString(request.resource.data.displayName, 1, 150);
      allow delete: if isOwner(userId);
    }

    // 4. Exact email lookup directory for partner invitations
    // Strictly backend-only. Direct client reads (both get and list) are completely prohibited.
    match /user_directory_lookup/{emailHash} {
      allow get: if isSignedIn(); // Allow searching by exact hash
      allow list: if false; // BLOCK MASS ENUMERATION!
      allow create, update: if isSignedIn() &&
        isValidId(emailHash) &&
        request.resource.data.uid == request.auth.uid &&
        isSafeString(request.resource.data.email, 3, 150) &&
        isSafeString(request.resource.data.displayName, 1, 150);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // 5. Shared Connections between two users
    match /shared_connections/{connectionId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;
      
      allow create: if isSignedIn() &&
        isValidId(connectionId) &&
        request.resource.data.id == connectionId &&
        request.resource.data.members is list &&
        request.resource.data.members.size() == 2 &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.status in ['active', 'pending', 'inactive', 'cancelled'];

      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.members &&
        request.resource.data.members == resource.data.members &&
        request.resource.data.status in ['active', 'pending', 'inactive', 'cancelled'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'userProfiles', 'memberProfiles']) &&
        (
          !request.resource.data.keys().hasAny(['userProfiles']) ||
          request.resource.data.userProfiles.get(
            (resource.data.members[0] == request.auth.uid) ? resource.data.members[1] : resource.data.members[0], null
          ) == resource.data.get('userProfiles', {}).get(
            (resource.data.members[0] == request.auth.uid) ? resource.data.members[1] : resource.data.members[0], null
          )
        ) &&
        (
          !request.resource.data.keys().hasAny(['memberProfiles']) ||
          request.resource.data.memberProfiles.get(
            (resource.data.members[0] == request.auth.uid) ? resource.data.members[1] : resource.data.members[0], null
          ) == resource.data.get('memberProfiles', {}).get(
            (resource.data.members[0] == request.auth.uid) ? resource.data.members[1] : resource.data.members[0], null
          )
        );

      allow delete: if isSignedIn() && request.auth.uid in resource.data.members;
    }

    // 6. Shared Invitations
    match /shared_invitations/{invitationId} {
      allow read: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );

      allow create: if isSignedIn() &&
        isValidId(invitationId) &&
        request.resource.data.id == invitationId &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.toUserId is string &&
        request.resource.data.toUserId != request.auth.uid &&
        request.resource.data.status == 'pending';

      allow update: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      ) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.fromUserId == resource.data.fromUserId &&
        request.resource.data.toUserId == resource.data.toUserId &&
        resource.data.status == 'pending' &&
        (request.resource.data.status in ['accepted', 'rejected', 'canceled']) &&
        ((request.resource.data.status in ['accepted', 'rejected']) ? request.auth.uid == resource.data.toUserId : true) &&
        ((request.resource.data.status == 'canceled') ? request.auth.uid == resource.data.fromUserId : true);

      allow delete: if isSignedIn() && (
        resource == null ||
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
    }

    // 7. Shared Bills - Absolute Financial Data Protection
    match /shared_bills/{billId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;

      allow create: if isSignedIn() &&
        isValidId(billId) &&
        request.resource.data.id == billId &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.members is list &&
        request.resource.data.members.size() == 2 &&
        request.auth.uid in request.resource.data.members &&
        isSafeNumber(request.resource.data.amount, 0.01, 1000000000) &&
        isSafeString(request.resource.data.title, 1, 200) &&
        hasActiveConnection(request.resource.data.members[0], request.resource.data.members[1]);

      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.members &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.members == resource.data.members &&
        // ABSOLUTE INVARIANT: Partner's share object (amount, percentage, status)
        // and percentage MUST remain strictly unchanged in ALL member updates!
        partnerShareUnchanged() &&
        partnerPercentageUnchanged() &&
        (
          // Action A: Payment status, share transfer, creditor payment, reimbursement, share request
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'shares', 'status', 'paidBy', 'paidAt', 'paidAmount', 'paymentResponsibility',
            'reimbursement', 'shareRequest', 'exceptions', 'updatedAt'
          ]) ||
          // Action B: Bill metadata and amount adjustments (partner share remains 100% untouched)
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'title', 'amount', 'dueDate', 'dueDay', 'month', 'category', 'notes',
              'splitMethod', 'percentages', 'shares', 'shareRequest', 'updatedAt', 'recurrenceMonthsCount'
            ]) &&
            isSafeNumber(request.resource.data.amount, 0.01, 1000000000) &&
            isSafeString(request.resource.data.title, 1, 200)
          ) ||
          // Action C: Hiding bill for oneself
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenForUsers', 'updatedAt']) &&
            isValidHiddenForUsersUpdate()
          )
        );

      allow delete: if isSignedIn() && request.auth.uid == resource.data.createdBy;
    }

    // 8. Shared Transfers - Allow adding/removing caller's own UID to hiddenForUsers
    match /shared_transfers/{transferId} {
      allow read: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );

      allow create: if isSignedIn() &&
        isValidId(transferId) &&
        request.resource.data.id == transferId &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.toUserId is string &&
        request.resource.data.toUserId != request.auth.uid &&
        isSafeNumber(request.resource.data.amount, 0.01, 1000000000) &&
        request.resource.data.status == 'completed' &&
        hasActiveConnection(request.auth.uid, request.resource.data.toUserId);

      allow update: if isSignedIn() &&
        (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenForUsers']) &&
        isValidHiddenForUsersUpdate();

      allow delete: if false;
    }

    // 9. Shared Notifications
    match /shared_notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
        isValidId(notificationId) &&
        request.resource.data.id == notificationId &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.userId is string &&
        request.resource.data.userId.size() > 0 &&
        request.resource.data.type in [
          'invitation_received', 'invitation_accepted', 'invitation_rejected',
          'bill_created', 'bill_updated', 'bill_paid',
          'transfer_received', 'share_bill_request', 'share_bill_accepted', 'share_bill_rejected',
          'reimbursement_created'
        ] &&
        isSafeString(request.resource.data.title, 1, 200) &&
        isSafeString(request.resource.data.message, 1, 1000);

      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.fromUserId == resource.data.fromUserId &&
        request.resource.data.title == resource.data.title &&
        request.resource.data.message == resource.data.message &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.isRead is bool;

      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // 10. Password Resets (Server-side handled via REST)
    match /password_resets/{resetId} {
      allow read, write: if false;
    }
  }
}

